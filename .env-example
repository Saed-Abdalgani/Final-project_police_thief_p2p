# Copy this file to .env only for local development. Never commit .env.
# M1 does not load secrets; these paths document the future integration contract.

POLICE_THIEF_ARTIFACT_ROOT=./data/runtime
POLICE_THIEF_LOG_LEVEL=INFO
POLICE_THIEF_GMAIL_CREDENTIALS_FILE=./credentials.json
POLICE_THIEF_GMAIL_TOKEN_FILE=./token.json
