{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://police-thief-p2p.invalid/schemas/0.2.0/replay_audit.schema.json",
  "title": "Standalone Replay Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game_uid", "sub_game_number", "mode", "integrity", "accessible_status", "verified_steps", "expected_steps", "terminal_reason", "police_points", "thief_points", "frames", "findings", "track_banner", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "game_uid": {"type": "string", "format": "uuid"},
    "sub_game_number": {"type": "integer", "minimum": 1, "maximum": 6},
    "mode": {"enum": ["single-log", "objective-post-audit"]},
    "integrity": {"enum": ["Verified OK", "TAMPERED"]},
    "accessible_status": {"type": "string", "minLength": 3},
    "verified_steps": {"type": "integer", "minimum": 0},
    "expected_steps": {"type": "integer", "minimum": 0},
    "terminal_reason": {"type": "string"},
    "police_points": {"type": "integer", "minimum": 0},
    "thief_points": {"type": "integer", "minimum": 0},
    "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "track_banner": {"type": "string"},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "cell": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false},
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "actor", "actor_step", "action", "own_position", "police_position", "thief_position", "public_barriers", "belief_heatmap", "commitment_status", "terminal_reason"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "actor": {"enum": ["police", "thief"]},
        "actor_step": {"type": "integer", "minimum": 1},
        "action": {"type": "string"},
        "own_position": {"anyOf": [{"$ref": "#/$defs/cell"}, {"type": "null"}]},
        "police_position": {"anyOf": [{"$ref": "#/$defs/cell"}, {"type": "null"}]},
        "thief_position": {"anyOf": [{"$ref": "#/$defs/cell"}, {"type": "null"}]},
        "public_barriers": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "belief_heatmap": {"type": "array", "items": {"type": "string", "pattern": "^(?:0|1)(?:\\.\\d+)?$"}},
        "commitment_status": {"const": "Verified OK"},
        "terminal_reason": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "code", "evidence", "detail"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "evidence": {"type": "string"},
        "detail": {"type": "string"}
      }
    }
  }
}
