{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/police-thief/0.2.0/commitment_body.schema.json",
  "title": "Commitment body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commitment_version", "game_uid", "sub_game_number", "step_number", "actor",
    "pre_action_state_digest", "action", "hint", "verdict", "hint_semantic_intent", "public_effects",
    "token_count", "model_provider", "model_name", "config_sha256",
    "protocol_version", "scent_model_sha256", "scent_frame_sha256"
  ],
  "properties": {
    "commitment_version": {"const": "1.1.0"},
    "game_uid": {"type": "string", "format": "uuid"},
    "sub_game_number": {"type": "integer", "minimum": 1, "maximum": 6},
    "step_number": {"type": "integer", "minimum": 1},
    "actor": {"enum": ["police", "thief"]},
    "pre_action_state_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "direction", "target"],
      "properties": {
        "action_type": {"enum": ["MOVE", "STAY", "BARRIER"]},
        "direction": {"type": ["string", "null"], "enum": ["N", "S", "E", "W", null]},
        "target": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "prefixItems": [{"type": "integer"}, {"type": "integer"}],
              "items": false
            }
          ]
        }
      }
    },
    "hint": {"type": "string", "maxLength": 2000},
    "verdict": {"enum": ["truth", "lie"]},
    "hint_semantic_intent": {
      "enum": ["north", "south", "east", "west", "center", "edge", "corner", "neutral"]
    },
    "public_effects": {"type": "array", "items": {"type": "object"}},
    "token_count": {"type": "integer", "minimum": 0},
    "model_provider": {"type": "string", "minLength": 1, "maxLength": 100},
    "model_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_version": {"enum": ["0.5.0", "0.6.0", "0.7.0"]},
    "scent_model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scent_frame_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
