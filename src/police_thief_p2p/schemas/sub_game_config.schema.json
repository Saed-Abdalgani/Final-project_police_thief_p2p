{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://police-thief-p2p.invalid/schemas/0.2.0/sub_game_config.schema.json",
  "title": "Per-Sub-Game Configuration Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game_uid", "sub_game_number", "role", "config_digest", "raw_config_digest", "shared_config"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "game_uid": {"type": "string", "format": "uuid"},
    "sub_game_number": {"type": "integer", "minimum": 1, "maximum": 6},
    "role": {"enum": ["police", "thief"]},
    "config_digest": {"$ref": "#/$defs/digest"},
    "raw_config_digest": {"$ref": "#/$defs/digest"},
    "shared_config": {"type": "object"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
