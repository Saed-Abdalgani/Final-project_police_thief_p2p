{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/police-thief/0.2.0/final_reveal.schema.json",
  "title": "Final nonce reveal manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["game_uid", "sub_game_number", "entries", "manifest_sha256"],
  "properties": {
    "game_uid": {"type": "string", "format": "uuid"},
    "sub_game_number": {"type": "integer", "minimum": 1, "maximum": 6},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "game_uid", "sub_game_number", "step_number", "actor",
          "commitment_sha256", "nonce_hex"
        ],
        "properties": {
          "game_uid": {"type": "string", "format": "uuid"},
          "sub_game_number": {"type": "integer", "minimum": 1, "maximum": 6},
          "step_number": {"type": "integer", "minimum": 1},
          "actor": {"enum": ["police", "thief"]},
          "commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "nonce_hex": {"type": "string", "pattern": "^(?:[a-f0-9]{2}){16,}$"}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
