{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/police-thief/0.2.0/capture_statement.schema.json",
  "title": "Sealed capture statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game_uid", "sub_game_number", "step_number",
    "action_commitment_sha256", "kind", "captured"
  ],
  "properties": {
    "game_uid": {"type": "string"},
    "sub_game_number": {"type": "integer", "minimum": 1, "maximum": 6},
    "step_number": {"type": "integer", "minimum": 1},
    "action_commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kind": {"enum": ["claim", "response"]},
    "captured": {"type": "boolean"}
  },
  "not": {"anyOf": [{"required": ["position"]}, {"required": ["nonce"]}]}
}
