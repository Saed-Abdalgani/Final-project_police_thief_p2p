{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://police-thief-p2p.invalid/schemas/0.2.0/match_acceptance.schema.json",
  "title": "Exact Match Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_digest", "game_id", "game_uid", "schedule_digest"],
  "properties": {
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "game_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "game_uid": {"type": "string", "format": "uuid"},
    "schedule_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
