{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://police-thief-p2p.invalid/schemas/0.2.0/protocol_envelope.schema.json",
  "title": "Common Peer Protocol Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "message_type", "message_id", "correlation_id", "game_uid", "sub_game_number", "step_number", "sender", "sequence", "payload"],
  "properties": {
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "message_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "message_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "game_uid": {"type": "string", "format": "uuid"},
    "sub_game_number": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "step_number": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "role"],
      "properties": {
        "group_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,62}[A-Za-z0-9])?$"},
        "role": {"enum": ["police", "thief"]}
      }
    },
    "sequence": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "payload": {"type": "object"}
  }
}
